<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/toDoList">

    <fragment
        android:id="@+id/toDoList"
        android:name="com.example.futureme.ToDoListFragment"
        android:label="Tasks"
        tools:layout="@layout/fragment_to_do_list">
        <action
            android:id="@+id/action_toDoList_to_taskView"
            app:destination="@id/taskView" />
    </fragment>

    <fragment
        android:id="@+id/analytics"
        android:name="com.example.futureme.AnalyticsFragment"
        android:label="Analytics"
        tools:layout="@layout/fragment_analytics" />

    <fragment
        android:id="@+id/taskView"
        android:name="com.example.futureme.TaskViewFragment"
        android:label="Task Details"
        tools:layout="@layout/fragment_task_view">
        <action
            android:id="@+id/action_taskView_to_addEditTask"
            app:destination="@id/addEditTask" />
    </fragment>

    <fragment
        android:id="@+id/settings"
        android:name="com.example.futureme.SettingsFragment"
        android:label="Settings"
        tools:layout="@layout/fragment_settings" >
        <action
            android:id="@+id/action_settings_to_addTags"
            app:destination="@id/addTags" />
    </fragment>

    <fragment
        android:id="@+id/addEditTask"
        android:name="com.example.futureme.AddEditTaskFragment"
        android:label="Add/Edit Task"
        tools:layout="@layout/fragment_add_edit_task" />
    <fragment
        android:id="@+id/addTags"
        android:name="com.example.futureme.AddTags"
        android:label="Add Tags"
        tools:layout="@layout/fragment_add_tags" />
</navigation>
