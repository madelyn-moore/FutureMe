<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">

    <data>
        <variable
            name="viewModel"
            type="com.example.futureme.TasksViewModel" />
    </data>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:background="#F3E8FF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Page title -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="FutureMe Analytics"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#6200EE"
                android:paddingBottom="12dp" />

            <!-- Always-visible summary section -->
            <LinearLayout
                android:id="@+id/summaryContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/analytic_card"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Productivity Summary"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#6200EE"
                    android:paddingBottom="10dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text='@{"Tasks Postponed: " + viewModel.postponedTaskCount}'
                    android:textSize="18sp"
                    android:textColor="#1F1B24"
                    android:paddingBottom="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text='@{"Total Deferrals: " + viewModel.totalDeferrals}'
                    android:textSize="18sp"
                    android:textColor="#1F1B24"
                    android:paddingBottom="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text='@{"Average Delay (Days): " + viewModel.averageDelay}'
                    android:textSize="18sp"
                    android:textColor="#1F1B24"
                    android:paddingBottom="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text='@{"Overdue Tasks: " + viewModel.overdueCount}'
                    android:textSize="18sp"
                    android:textColor="#1F1B24"
                    android:paddingBottom="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text='@{"Most Deferred Task: " + viewModel.mostDeferredTaskName}'
                    android:textSize="18sp"
                    android:textColor="#1F1B24"
                    android:paddingBottom="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text='@{"Future Burden Score: " + viewModel.futureBurdenScore}'
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#6200EE" />
            </LinearLayout>

            <!-- Weekly delay section header -->
            <TextView
                android:id="@+id/weeklyHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Weekly Delay Trends"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:padding="14dp"
                android:background="#6200EE" />

            <!-- Weekly delay section content -->
            <LinearLayout
                android:id="@+id/weeklyContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:padding="12dp"
                android:background="@drawable/analytic_card"
                android:layout_marginBottom="12dp">

                <com.github.mikephil.charting.charts.LineChart
                    android:id="@+id/weeklyLineChart"
                    android:layout_width="match_parent"
                    android:layout_height="280dp" />
            </LinearLayout>

            <!-- Donut chart section header -->
            <TextView
                android:id="@+id/statusHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Task Behavior Breakdown"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:padding="14dp"
                android:background="#6200EE"
                android:layout_marginTop="4dp" />

            <!-- Donut chart section content -->
            <LinearLayout
                android:id="@+id/statusContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:padding="12dp"
                android:background="@drawable/analytic_card"
                android:layout_marginBottom="12dp">

                <com.github.mikephil.charting.charts.PieChart
                    android:id="@+id/statusDonutChart"
                    android:layout_width="match_parent"
                    android:layout_height="300dp" />
            </LinearLayout>

            <!-- Bar chart section header -->
            <TextView
                android:id="@+id/tagHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Overdue Tasks by Tag"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:padding="14dp"
                android:background="#6200EE"
                android:layout_marginTop="4dp" />

            <!-- Bar chart section content -->
            <LinearLayout
                android:id="@+id/tagContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:padding="12dp"
                android:background="@drawable/analytic_card"
                android:layout_marginBottom="12dp">

                <com.github.mikephil.charting.charts.BarChart
                    android:id="@+id/tagBarChart"
                    android:layout_width="match_parent"
                    android:layout_height="300dp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</layout>