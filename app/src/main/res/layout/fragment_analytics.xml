<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="viewModel"
            type="com.example.futureme.TasksViewModel" />
    </data>

    <!-- Scroll view-->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:background="?android:attr/windowBackground">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Future me titles-->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/futureme_analytics"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="?attr/colorPrimary"
                android:paddingBottom="12dp" />

            <!-- Summary section -->
            <LinearLayout
                android:id="@+id/summaryContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/analytic_card"
                android:layout_marginBottom="16dp">

                <!-- Productivity summary content-->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/productivity_summary"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorPrimary"
                    android:paddingBottom="10dp" />

                <!-- Task postponed content -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text='@{"Tasks Postponed: " + viewModel.postponedTaskCount}'
                    android:textSize="18sp"
                    android:textColor="?attr/colorOnSurface"
                    android:paddingBottom="8dp" />

                <!-- Total deferrals content -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text='@{"Total Deferrals: " + viewModel.totalDeferrals}'
                    android:textSize="18sp"
                    android:textColor="?attr/colorOnSurface"
                    android:paddingBottom="8dp" />

                <!-- Additional summary content -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text='@{"Average Delay (Days): " + viewModel.averageDelay}'
                    android:textSize="18sp"
                    android:textColor="?attr/colorOnSurface"
                    android:paddingBottom="8dp" />

                <!-- Overdue tasks content -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text='@{"Overdue Tasks: " + viewModel.overdueCount}'
                    android:textSize="18sp"
                    android:textColor="?attr/colorOnSurface"
                    android:paddingBottom="8dp" />

                <!-- Completed tasks content -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text='@{"Most Deferred Task: " + viewModel.mostDeferredTaskName}'
                    android:textSize="18sp"
                    android:textColor="?attr/colorOnSurface"
                    android:paddingBottom="8dp" />

                <!-- Future burden score content -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text='@{"Burden Score: " + viewModel.futureBurdenScore}'
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorPrimary" />
            </LinearLayout>

            <!-- Weekly delay section header -->
            <TextView
                android:id="@+id/weeklyHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/weekly_delay_trends"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnPrimary"
                android:padding="14dp"
                android:background="?attr/colorPrimary" />

            <!-- Weekly delay section content -->
            <LinearLayout
                android:id="@+id/weeklyContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp"
                android:background="@drawable/analytic_card"
                android:visibility="gone"
                android:layout_marginBottom="12dp">

                <com.github.mikephil.charting.charts.LineChart
                    android:id="@+id/weeklyLineChart"
                    android:layout_width="match_parent"
                    android:layout_height="280dp" />
            </LinearLayout>

            <!-- Donut chart section header -->
            <TextView
                android:id="@+id/statusHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/task_behavior_breakdown"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnPrimary"
                android:padding="14dp"
                android:background="?attr/colorPrimary"
                android:layout_marginTop="4dp" />

            <!-- Donut chart section content -->
            <LinearLayout
                android:id="@+id/statusContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp"
                android:background="@drawable/analytic_card"
                android:visibility="gone"
                android:layout_marginBottom="12dp">

                <com.github.mikephil.charting.charts.PieChart
                    android:id="@+id/statusDonutChart"
                    android:layout_width="match_parent"
                    android:layout_height="300dp" />
            </LinearLayout>

            <!-- Bar chart section header -->
            <TextView
                android:id="@+id/tagHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/overdue_tasks_by_tag"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnPrimary"
                android:padding="14dp"
                android:background="?attr/colorPrimary"
                android:layout_marginTop="4dp" />

            <!-- Bar chart section content -->
            <LinearLayout
                android:id="@+id/tagContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp"
                android:background="@drawable/analytic_card"
                android:visibility="gone"
                android:layout_marginBottom="12dp">

                <com.github.mikephil.charting.charts.BarChart
                    android:id="@+id/tagBarChart"
                    android:layout_width="match_parent"
                    android:layout_height="300dp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</layout>
