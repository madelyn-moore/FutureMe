<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="viewModel"
            type="com.example.futureme.TasksViewModel" />
    </data>

    <!--Scroll view-->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:background="?android:attr/windowBackground"
        tools:context=".AddEditTaskFragment">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <!-- task name -->
                <EditText
                    android:id="@+id/addEditTaskName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="12dp"
                    android:hint="@string/task_name"
                    android:inputType="text"
                    android:text="@={viewModel.newTaskName}"
                    android:textColor="?attr/colorOnSurface"
                    android:background="?attr/colorSurface"
                    android:textColorHint="?android:attr/textColorSecondary"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <!-- Due date title-->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/due_date_mm_dd_yyyy"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <!-- Due date input -->
                    <!-- Default to today's date -->
                    <EditText
                        android:id="@+id/editNewDueDate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@{viewModel.getCurrentDateString()}"
                        android:inputType="text"
                        android:text="@={viewModel.newDueDate}"
                        android:textColor="?attr/colorOnSurface"
                        android:background="?attr/colorSurface"
                        android:textColorHint="?android:attr/textColorSecondary"
                        android:textSize="16sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="12dp">

                    <!-- Tags title -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tags"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="4dp"
                        android:background="@android:drawable/edit_text"
                        android:backgroundTint="?attr/colorSurface">

                        <!-- Spinner for tags -->
                        <Spinner
                            android:id="@+id/tagSpinner"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp"
                            android:backgroundTint="?attr/colorOnSurface"
                            android:popupBackground="?attr/colorSurface" />
                    </FrameLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <!-- Date postponed title -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/date_postponed_mm_dd_yyyy"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <!-- Date postponed input -->
                    <EditText
                        android:id="@+id/datePostponed"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@{viewModel.getCurrentDateString()}"
                        android:inputType="text"
                        android:text="@={viewModel.newDatePostponed}"
                        android:textColor="?attr/colorOnSurface"
                        android:background="?attr/colorSurface"
                        android:textColorHint="?android:attr/textColorSecondary"
                        android:textSize="16sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Description title -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/description"
                android:textColor="?attr/colorOnSurface"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- description input -->
            <EditText
                android:id="@+id/addEditDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:gravity="top|start"
                android:hint="@string/description_goes_here"
                android:inputType="textMultiLine"
                android:minLines="3"
                android:text="@={viewModel.newDescription}"
                android:textColor="?attr/colorOnSurface"
                android:background="?attr/colorSurface"
                android:textColorHint="?android:attr/textColorSecondary"
                android:textSize="16sp" />

            <!-- Why task was pushed off title -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/why_task_was_pushed_off"
                android:textColor="?attr/colorOnSurface"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- why task was pushed off input -->
            <EditText
                android:id="@+id/addEditWhyTaskPushedOff"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:gravity="top|start"
                android:hint="@string/why_task_was_pushed_off_hint"
                android:inputType="textMultiLine"
                android:minLines="3"
                android:text="@={viewModel.newWhyTaskPushedOff}"
                android:textColor="?attr/colorOnSurface"
                android:background="?attr/colorSurface"
                android:textColorHint="?android:attr/textColorSecondary"
                android:textSize="16sp" />

            <!-- Penalties title -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/penalties_for_pushing_off_task_if_any"
                android:textColor="?attr/colorOnSurface"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Penalties input -->
            <EditText
                android:id="@+id/addEditPenalties"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:gravity="top|start"
                android:hint="@string/penalties_for_pushing_off_task_if_any_hint"
                android:inputType="textMultiLine"
                android:minLines="2"
                android:text="@={viewModel.newPenalties}"
                android:textColor="?attr/colorOnSurface"
                android:background="?attr/colorSurface"
                android:textColorHint="?android:attr/textColorSecondary"
                android:textSize="16sp" />


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="12dp">

                    <!-- Total number of delayed days title -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/total_number_of_delayed_days"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <!-- This is a display of the number of delayed days calculated from the database -->
                    <TextView
                        android:id="@+id/numDaysDelayed"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:text="@{viewModel.newNumDaysDelayed}"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="16sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <!-- Checkbox showing if the task is overdue -->
                    <CheckBox
                        android:id="@+id/overdueStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="@{viewModel.newOverdueStatus}"
                        android:enabled="false"
                        android:text="@string/overdue"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <!-- Date completed title -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:text="@string/date_completed_mm_dd_yyyy"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <!-- date completed input grabs from database if checkbox on to do list is clicked -->
                <EditText
                    android:id="@+id/dateCompleted"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:hint="@{viewModel.getCurrentDateString()}"
                    android:inputType="text"
                    android:text="@={viewModel.newDateCompleted}"
                    android:textColor="?attr/colorOnSurface"
                    android:background="?attr/colorSurface"
                    android:textColorHint="?android:attr/textColorSecondary"
                    android:textSize="16sp" />
            </LinearLayout>

            <!-- Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Save button -->
                <Button
                    android:id="@+id/saveButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="@string/save" />

                <!-- Delete button -->
                <Button
                    android:id="@+id/deleteButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/delete"
                    android:textSize="12sp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</layout>
