<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.FutureMe" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary colors for light mode-->
        <item name="colorPrimary">@color/purple_primary</item>
        <item name="colorPrimaryVariant">@color/purple_primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        
        <!-- Backgrounds -->
        <item name="android:windowBackground">@color/white</item>
        <item name="colorSurface">@color/purple_light_bg</item>
        <item name="colorOnSurface">@color/text_dark</item>
    </style>

    <style name="Theme.FutureMe" parent="Base.Theme.FutureMe" />
</resources>
